<?xml version="1.0"?>
<package format="3">
  <name>auto_mode_manager</name>
  <version>0.2.0</version>
  <description>Automatic navigation, yaw tracking and shot coordination</description>
  <maintainer email="contact@gn10.org">Robocon Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>robot_port</depend>
  <depend>gn10_navigation</depend>
  <depend>lidar_perception_system</depend>
  <depend>field_target_pub</depend>
  <depend>shooter_calculator</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>
